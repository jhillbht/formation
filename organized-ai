#!/usr/bin/env bash

###############################################################################
# ERROR: Let the user know if the script fails
###############################################################################

trap 'ret=$?; test $ret -ne 0 && printf "\n   \e[31m\033[0m  Organized-AI setup failed  \e[31m\033[0m\n" >&2; exit $ret' EXIT

set -e

###############################################################################
# TWIRL: Check for required functions file
###############################################################################

if [ -e twirl ]; then
	cd "$(dirname "${BASH_SOURCE[0]}")" \
		&& . "twirl"
else
	printf "\n ⚠️  ./twirl not found  🤖 First, you need the supporting functions\n"
	exit 1
fi

###############################################################################
# CHECK: Bash version
###############################################################################

check_bash_version

###############################################################################
# Get Organized for AI Development!
###############################################################################

printf "
   _____                       _              _          _____
  |  _  |                     (_)            | |   /\   |_   _|
  | | | |_ __ __ _  __ _ _ __  _ ___  ___  __| |  /  \    | |
  | | | | '__/ _\` |/ _\` | '_ \| |_  / _ \/ _\` | / /\ \   | |
  \ \_/ / | | (_| | (_| | | | | |/ /  __/ (_| |/ ____ \ _| |_
   \___/|_|  \__, |\__,_|_| |_|_/___\___|\__,_/_/    \_\_____|
              __/ |
             |___/

╭───────────────────────────────────────────────────╮
│  Supabowl AI Development Environment Setup        │
│───────────────────────────────────────────────────│
│  Safe to run multiple times on the same machine.  │
│  It ${green}installs${reset}, ${blue}upgrades${reset}, or ${yellow}skips${reset} packages based   │
│  on what is already installed on the machine.     │
│  Optimized for Newsense AI project structure.     │
╰───────────────────────────────────────────────────╯
   ${dim}$(get_os) $(get_os_version) ${normal} // ${dim}$BASH ${normal} // ${dim}$BASH_VERSION${reset}
"

###############################################################################
# CHECK: Internet
###############################################################################
chapter "Checking internet connection…"
check_internet_connection

###############################################################################
# PROMPT: Password
###############################################################################
chapter "Caching password…"
ask_for_sudo

###############################################################################
# PROMPT: SSH Key
###############################################################################
chapter 'Checking for SSH key…'
ssh_key_setup

###############################################################################
# INSTALL: Dependencies
###############################################################################
chapter "Installing Dependencies…"

# -----------------------------------------------------------------------------
# XCode
# -----------------------------------------------------------------------------
if type xcode-select >&- && xpath=$( xcode-select --print-path ) &&
	test -d "${xpath}" && test -x "${xpath}" ; then
	print_success_muted "Xcode already installed. Skipping."
else
	step "Installing Xcode…"
	xcode-select --install
	print_success "Xcode installed!"
fi

if [ ! -d "$HOME/.bin/" ]; then
	mkdir "$HOME/.bin"
fi

# -----------------------------------------------------------------------------
# Supabowl workspace directory
# -----------------------------------------------------------------------------
if [ ! -d "$HOME/supabowl-workspace/" ]; then
	step "Creating Supabowl workspace…"
	mkdir -p "$HOME/supabowl-workspace"
	mkdir -p "$HOME/supabowl-workspace/newsense-projects"
	mkdir -p "$HOME/supabowl-workspace/believe-configs"
	mkdir -p "$HOME/supabowl-workspace/models"
	mkdir -p "$HOME/supabowl-workspace/datasets"
	mkdir -p "$HOME/supabowl-workspace/experiments"
	mkdir -p "$HOME/supabowl-workspace/notebooks"
	print_success "Supabowl workspace created!"
else
	print_success_muted "Supabowl workspace already exists. Skipping."
fi

# -----------------------------------------------------------------------------
# Bash-it
# -----------------------------------------------------------------------------
if [ -d "$HOME/.bash_it" ]; then
	print_success_muted "Bash-it already installed. Skipping."
else
	step "Installing Bash-it…"
	git clone --depth=1 https://github.com/Bash-it/bash-it.git ~/.bash_it
	~/.bash_it/install.sh --silent --no-modify-config
	print_success "Bash-it installed!"
fi

# -----------------------------------------------------------------------------
# Python via pyenv (for AI development)
# -----------------------------------------------------------------------------
if ! [ -x "$(command -v pyenv)" ]; then
	step "Installing pyenv for Python management…"
	curl https://pyenv.run | bash
	print_success "pyenv installed!"
	
	step "Installing Python 3.11 for AI development…"
	export PATH="$HOME/.pyenv/bin:$PATH"
	eval "$(pyenv init -)"
	pyenv install 3.11.0
	pyenv global 3.11.0
	print_success "Python 3.11 installed!"
else
	print_success_muted "pyenv already installed. Skipping."
fi

# -----------------------------------------------------------------------------
# NVM & Node.js
# -----------------------------------------------------------------------------
if [ -x nvm ]; then
	step "Installing NVM…"
	curl -o- https://raw.githubusercontent.com/creationix/nvm/v0.33.11/install.sh | bash
	print_success "NVM installed!"
	step "Installing latest Node…"
	nvm install node
	nvm use node
	nvm run node --version
	nodev=$(node -v)
	print_success "Using Node $nodev!"
else
	print_success_muted "NVM/Node already installed. Skipping."
fi

# -----------------------------------------------------------------------------
# Homebrew
# -----------------------------------------------------------------------------
if ! [ -x "$(command -v brew)" ]; then
	step "Installing Homebrew…"
	curl -fsS 'https://raw.githubusercontent.com/Homebrew/install/master/install' | ruby
	export PATH="/usr/local/bin:$PATH"
	print_success "Homebrew installed!"
else
	print_success_muted "Homebrew already installed. Skipping."
fi

if brew list | grep -Fq brew-cask; then
	step "Uninstalling old Homebrew-Cask…"
	brew uninstall --force brew-cask
	print_success "Homebrew-Cask uninstalled!"
fi

###############################################################################
# INSTALL: believe configurations (brews)
###############################################################################
if [ -e $cwd/believe/brews ]; then
	chapter "Installing Homebrew formulae from believe configs…"

	for brew in $(<$cwd/believe/brews); do
		install_brews $brew
	done
fi

###############################################################################
# UPDATE: Homebrew
###############################################################################
chapter "Updating Homebrew formulae…"
brew update

###############################################################################
# INSTALL: believe configurations (casks)
###############################################################################
if [ -e $cwd/believe/casks ]; then
	chapter "Installing apps via Homebrew from believe configs…"

	for cask in $(<$cwd/believe/casks); do
	    install_application_via_brew $cask
	done
fi

###############################################################################
# INSTALL: AI Python packages
###############################################################################
chapter "Installing AI development packages…"
step "Installing core AI libraries…"
pip install --upgrade pip
pip install anthropic openai jupyter numpy pandas matplotlib seaborn scikit-learn torch transformers
print_success "AI libraries installed!"

###############################################################################
# INSTALL: Mac App Store Apps
###############################################################################
chapter "Installing apps from App Store…"
if [ -x mas ]; then

	print_warning "Please install mas-cli first: brew mas. Skipping."

	else

	if [ -e $cwd/believe/apps ]; then
		if mas_setup; then
			# Workaround for associative array in Bash 3
			# https://stackoverflow.com/questions/6047648/bash-4-associative-arrays-error-declare-a-invalid-option
			for app in $(<$cwd/believe/apps); do
				KEY="${app%%::*}"
				VALUE="${app##*::}"
				install_application_via_app_store $KEY $VALUE
			done
		else
			print_warning "Please signin to App Store first. Skipping."
		fi
	fi

fi

###############################################################################
# CLEAN: Homebrew files
###############################################################################
chapter "Cleaning up Homebrew files…"
brew cleanup 2> /dev/null

###############################################################################
# INSTALL: npm packages
###############################################################################
if [ -e $cwd/believe/npm ]; then
	chapter "Installing npm packages from believe configs…"

	for pkg in $(<$cwd/believe/npm); do
		KEY="${pkg%%::*}"
		VALUE="${pkg##*::}"
		install_npm_packages $KEY $VALUE
	done
fi

###############################################################################
# OPTIONAL: Jordaaan Customizations
###############################################################################
chapter "Adding jordaaan customizations…"
if [ -f "$HOME/.jordaaan" ]; then
	if ask "Do you want to add jordaaan customizations?" Y; then
		. "$HOME/.jordaaan"; printf "\n  🤖 Jordaaan customizations applied! ${bold}Newsense AI environment ready.${normal}\n";
	else
		print_success_muted "Jordaaan customizations declined. Skipped.";
	fi
else
	print_warning "No ~/.jordaaan found. Create one for personal AI development customizations."
fi

###############################################################################
# 🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖🤖
###############################################################################
printf "\n"
printf "╭─────────────────────────────────────────────────────────╮\n"
printf "│  🎉 Organized-AI setup complete!                        │\n"
printf "│                                                         │\n"
printf "│  Your Supabowl AI development environment is ready:     │\n"
printf "│  📁 ~/supabowl-workspace/newsense-projects              │\n"
printf "│  ⚙️  ~/supabowl-workspace/believe-configs               │\n"
printf "│  🧠 AI libraries: Claude, OpenAI, Jupyter, PyTorch      │\n"
printf "│  🐍 Python 3.11 with pyenv                             │\n"
printf "│  📝 Custom configs in ~/.jordaaan                       │\n"
printf "│                                                         │\n"
printf "│  Next steps:                                            │\n"
printf "│  1. Create a newsense AI project structure             │\n"
printf "│  2. Configure your believe settings                     │\n"
printf "│  3. Start building with organized AI workflows!        │\n"
printf "╰─────────────────────────────────────────────────────────╯\n"
printf "\n"
